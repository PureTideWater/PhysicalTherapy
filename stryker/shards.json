{
  "$comment": "The mutation workflow's shard jobs (stryker/base.mjs, TP_MUTATION_SHARD; docs/adr/0066, Part 4). Every file a package's config mutates is in exactly one shard, and a shard runs its files in full. The split balances the wall time and summed mutant time Stryker 10.1.1 measured at 49514e8 (the mutation scout's 10.1.1 reports, 4 shared CPUs): money (34 s) with ledger (2 min 28 s); packets' scan.ts (939 s of mutant time) against the rest of packets (997 s); pricing's engine.ts (1,232 s), recompute.ts (952 s) and the rest of pricing (804 s).",
  "shards": [
    {
      "name": "money-ledger",
      "mutate": {
        "money": [
          "packages/money/src/cents.ts",
          "packages/money/src/decimal.ts",
          "packages/money/src/index.ts",
          "packages/money/src/rounding.ts"
        ],
        "ledger": [
          "packages/ledger/src/allocation.ts",
          "packages/ledger/src/csv.ts",
          "packages/ledger/src/index.ts",
          "packages/ledger/src/matching.ts",
          "packages/ledger/src/pairing.ts",
          "packages/ledger/src/reconciliation.ts",
          "packages/ledger/src/roi.ts",
          "packages/ledger/src/settings.ts",
          "packages/ledger/src/stages.ts",
          "packages/ledger/src/statement.ts",
          "packages/ledger/src/templates.ts",
          "packages/ledger/src/totals.ts"
        ]
      }
    },
    {
      "name": "packets-scan",
      "mutate": {
        "packets": [
          "packages/packets/src/scan.ts"
        ]
      }
    },
    {
      "name": "packets-rest",
      "mutate": {
        "packets": [
          "packages/packets/src/assemble.ts",
          "packages/packets/src/calculation.ts",
          "packages/packets/src/dates.ts",
          "packages/packets/src/facts.ts",
          "packages/packets/src/interest.ts",
          "packages/packets/src/payer.ts",
