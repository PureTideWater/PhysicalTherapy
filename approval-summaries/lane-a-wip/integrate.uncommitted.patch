+    const codePoints = (block: number) => {
+      const points: number[] = [];
+      for (let point = Math.max(block * 4096, 1); point < Math.min((block + 1) * 4096, 0x110000); point += 1) {
+        if (point < 0xd800 || point > 0xdfff) {
+          points.push(point);
+        }
+      }
+      return points;
+    };
