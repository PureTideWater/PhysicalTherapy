          "packages/packets/src/windows.ts"
        ]
      }
    },
    {
      "name": "pricing-engine",
      "mutate": {
        "pricing": [
          "packages/pricing/src/engine.ts"
        ]
      }
    },
    {
      "name": "pricing-recompute",
      "mutate": {
        "pricing": [
          "packages/pricing/src/recompute.ts"
        ]
      }
