const mk = (names: string[], memberIds = ['SYNMEMBER0042'], claimNumbers = ['SYNCLAIM0001']) => ({ P: { pseudonym: 'synthetic-patient-1', names, datesOfBirth: ['1980-03-14'], memberIds }, C: [{ claimId: 'synthetic-claim-1', patientPseudonym: 'synthetic-patient-1', claimNumbers }] });
const run = (M: typeof B, text: string, pt: ReturnType<typeof mk>) => { const s = M.redactLetterForScreen(text, pt.P, pt.C); return { text: s.text as string, refused: M.holdsIdentifier(s.text, pt.P, pt.C) as boolean }; };
const tally = new Map<string, number>();
const show = (id: string, names: string[], text: string, memberIds?: string[], claims?: string[]) => {
  const pt = mk(names, memberIds, claims); const b = run(B, text, pt); const h = run(H, text, pt);
  const mark = !b.refused && h.refused ? 'NEW-REFUSAL' : b.refused && !h.refused ? 'BLOCKING' : b.refused && h.refused ? 'both-refuse' : b.text !== h.text ? 'new-redaction' : 'same';
  tally.set(`${id} ${mark}`, (tally.get(`${id} ${mark}`) ?? 0) + 1);
  console.log(`${id} ${mark.padEnd(13)} letter ${JSON.stringify(text)}\n      names ${JSON.stringify(names)} memberIds ${JSON.stringify(pt.P.memberIds)} claimNumbers ${JSON.stringify(pt.C[0]!.claimNumbers)} datesOfBirth ["1980-03-14"]\n      base ${b.refused ? 'REFUSED' : 'sent   '} ${JSON.stringify(b.text)}\n      head ${h.refused ? 'REFUSED' : 'sent   '} ${JSON.stringify(h.text)}`);
};
