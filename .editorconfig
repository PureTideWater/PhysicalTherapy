root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# X12 fixtures keep their bytes exactly as generated (delimiters, CRLF and BOM cases).
[fixtures/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
charset = unset

# The database function files hold each definition exactly as PostgreSQL prints it, trailing spaces in a body
# included, and end as the generator ends them (pnpm db:domain-model --out; docs/adr/0068): no editor rewrites them.
[packages/db/functions/**]
trim_trailing_whitespace = unset
insert_final_newline = unset
