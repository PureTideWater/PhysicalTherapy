// A test file that calls a model directly instead of through @tp/model-gateway. It is a fixture: the
// lint test (src/lint.test.ts) lints this text as if it lived outside packages/model-gateway and expects
// every import below to fail the repository's ESLint config (PRD 14: "a lint rule that fails the build
// on any other import of the provider SDK"). It is never run or compiled.
import Anthropic from '@anthropic-ai/sdk';
import { AnthropicBedrock } from '@anthropic-ai/bedrock-sdk';
import { BedrockRuntimeClient, InvokeModelCommand } from '@aws-sdk/client-bedrock-runtime';
import { describe, expect, it } from 'vitest';

describe('a narrative drafted outside the gateway', () => {
  it('calls the provider itself', async () => {
    const client = new Anthropic();
    const bedrock = new BedrockRuntimeClient({ region: 'us-east-1' });
    const legacy = new AnthropicBedrock();
    const sdk = await import('@anthropic-ai/sdk');
    expect([client, bedrock, legacy, sdk, InvokeModelCommand]).toHaveLength(5);
  });
});
