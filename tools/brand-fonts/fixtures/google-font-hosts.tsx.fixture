// A fixture for tools/brand-fonts/scan.test.ts: a layout that asks Google's font hosts for its faces, which the
// font check must fail wherever it is copied into a source tree. Its extension keeps the real check from reading it.
export default function Layout({ children }: { children: React.ReactNode }) {
  return (
    <html lang="en">
      <head>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossOrigin="" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600&display=swap" />
        <style>{`@import url('https://FONTS.GOOGLEAPIS.COM/css2?family=IBM+Plex+Mono');`}</style>
      </head>
      <body>{children}</body>
    </html>
  );
}
