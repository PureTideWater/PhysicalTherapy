// bodies42.mts: real-shaped letter bodies for Queues item 42's generated set and its false-find measures. Invented
// text in the shape of payer letters (denial, remittance summary, appeal, refund request, records request, prior
// authorization, coordination of benefits, timely filing, a faxed cover sheet, an all-capitals notice). Every person,
// number, address and phone is synthetic (555-01 phones, 9xx area, drawn digits). {NAME} {GIVEN} {SURNAME} {MEMBER}
// {CLAIM} {DOB} are written from the row's synthetic patient, plainly, as a real letter writes them.
export const BODIES: [string, string][] = [
  ['denial', `BlueCross BlueShield of the Tidewater\nP.O. Box 30555, Norfolk, VA 23501-0555\n\nNovember 3, 2026\n\nRe: Claim {CLAIM}\nPatient: {NAME}\nMember ID: {MEMBER}\nDate of birth: {DOB}\nDates of service: 09/14/2026 - 09/28/2026\n\nDear Provider:\n\nWe reviewed the claim above. CPT 97110 (4 units) was allowed at $31.42 per unit, $125.68 in all. CPT 97140 (2 units) was denied: the service is included in 97530 billed on the same day (CARC 97, RARC M80). CPT 97112 x 2 was paid at $34.11 each. Modifier 59 was not on the claim. Modifier GP and KX were read.\n\nBilled $540.00. Allowed $193.90. Patient responsibility $40.00 (copay). Paid $153.90 on 10/20/2026 by EFT, trace 081000032.\n\nYou may ask for a review within 180 days of this notice. Call 1-800-555-0199, Monday to Friday, 8 a.m. to 6 p.m., or fax (757) 555-0142.\n\nSincerely,\nProvider Appeals, Dept. 12`],
  ['remit-summary', `EXPLANATION OF PAYMENT\nPayer: UnitedHealthcare   Payee NPI: 1999999984   Check/EFT: 2026101455   Date: 10/14/2026\n\nPATIENT: {NAME}   ID: {MEMBER}   CLAIM: {CLAIM}\nDOS        CPT    MOD  UNITS  BILLED   ALLOWED  ADJ      PAID    REMARK\n09/02/2026 97110  GP   2      120.00   62.84    57.16    50.27   CO-45\n09/02/2026 97530  GP   1      75.00    38.20    36.80    30.56   CO-45\n09/02/2026 97014       1      30.00    0.00     30.00    0.00    CO-97 N130\n09/09/2026 G0283  GP   1      30.00    12.10    17.90    9.68    CO-45 PR-2\nCLAIM TOTALS                  255.00   113.14   141.86   90.51\nSequestration 2% applied: 1.85. MPPR applied to 97530: 50% of the practice expense.\nPage 1 of 2`],
  ['appeal-upheld', `TriWest Healthcare Alliance\nAppeals and Grievances\n\nRE: {NAME}, member {MEMBER}, claim {CLAIM}\n\nDear Ms. {SURNAME},\n\nThank you for your appeal, received October 2, 2026. We upheld the denial of physical therapy visits 13 to 24. Your plan covers 12 visits per calendar year (Evidence of Coverage, section 4.2, page 37). Visits 1-12 were paid in full. For visits 13 through 24, billed at $95.00 each ($1,140.00), no further benefit is payable.\n\nIf you disagree, you may ask for an external review within 4 months. Write to the address above or call OneCall Member Services at 1 (800) 555-0123, TTY 711.\n\nThis decision was made by a physical therapist reviewer on 10/28/2026 at 2:15 p.m.`],
  ['refund-request', `HealthSpring Recovery Unit\nSecond request\n\nProvider: Tidewater Therapy Partners, TIN ending 4417\nPatient {NAME} ({MEMBER}), claim {CLAIM}\n\nOur records show an overpayment of $212.36 on the claim above. The claim was paid twice: $212.36 on 07/08/2026 (check 00481516) and $212.36 on 07/22/2026 (check 00482342). Please return $212.36 within 30 days, or we will offset it against future payments under section 7(b) of your agreement.\n\nMail refunds to: Lockbox 7731, P.O. Box 9040, Richmond, VA 23225. Questions: 804-555-0177 ext. 2204.`],
  ['records-request', `WellPoint Medical Review\nFAX COVER: 3 pages to 757.555.0188\n\nWe need records to finish review of claim {CLAIM} for {GIVEN} {SURNAME}, DOB {DOB}, ID {MEMBER}.\nPlease send: (1) the plan of care signed by the physician; (2) daily notes for 08/03/2026, 08/05/2026 and 08/10/2026; (3) the progress report at visit 10; (4) minutes for each timed code (97110, 97112, 97116, 97530, 97535).\nThe 8-minute rule applies: 23-37 minutes is 2 units, 38-52 minutes is 3 units.\nSend within 45 days. Reference number MR-2026-118204. Reviewer: nurse reviewer 14.`],
  ['prior-auth', `MedStar Family Choice - Utilization Management\nAuthorization notice\n\nMember: {NAME}   Member number: {MEMBER}   Born: {DOB}\nAuthorization: PA2026-0934471   Status: PARTIALLY APPROVED\n\nRequested: 97110, 97112, 97140, 97530; 3 x week for 8 weeks (24 visits). Approved: 2 x week for 6 weeks (12 visits), 10/01/2026 to 11/15/2026. Not approved: 12 visits, for want of documented functional gains (MCG guideline A-0346).\nDiagnosis: M54.50, M25.561. Place of service 11.\nA peer-to-peer review may be asked for by calling 410-555-0105 by 10/08/2026, 5:00 PM ET.`],
  ['cob', `HealthSmart Benefit Solutions\nCoordination of Benefits\n\nClaim {CLAIM} for {NAME} cannot be processed. Our records show other coverage that is primary (HealthFirst plan, effective 01/01/2026). Send the primary payer's explanation of benefits with the claim. If the patient has no other coverage, the patient must call us at 800.555.0166 to update the file.\n\nCharges held: $380.00 (97161 $140.00; 97110 x 4 $160.00; 97140 x 2 $80.00).\nClaim received 09/30/2026; this notice 10/12/2026; timely filing limit 365 days from the date of service.`],
  ['timely-filing', `HomeLink / MedRisk Workers' Compensation Network\n\nDENIAL - TIMELY FILING\nClaimant: {NAME}\nClaim no.: {CLAIM}\nDate of injury: 03/02/2025\n\nThe bill for dates of service 01/06/2026 through 01/27/2026 (8 visits, $760.00) was received on 08/19/2026, more than 180 days after the first date of service. Fee schedule 8 VAC 20-131. Bill ID 5519027. The bill is denied in full; the injured worker may not be billed.\n\nReconsideration: send proof of timely filing (a clearinghouse report with the payer's accept date) to Bill Review, Suite 400, 1200 Granby Street, Norfolk VA 23510.`],
  ['all-caps', `NOTICE OF ADVERSE BENEFIT DETERMINATION\nPATIENT NAME: {NAME}\nSUBSCRIBER ID: {MEMBER}\nCLAIM NUMBER: {CLAIM}\nPROVIDER: TIDEWATER THERAPY PARTNERS\nSERVICE: PHYSICAL THERAPY, 97110 97112 97140, 09/14/2026\nAMOUNT BILLED: $285.00   AMOUNT ALLOWED: $0.00\nREASON: SERVICES EXCEED THE PLAN'S VISIT LIMIT (30 VISITS PER BENEFIT YEAR). FEES FOR MISSED VISITS ARE NOT COVERED. THE MEMBER IS LIABLE FOR $285.00.\nAPPEAL RIGHTS: YOU HAVE 180 DAYS. CALL 1-888-555-0134.`],
  ['short-note', `Per our call on 10/05 at 9:40, claim {CLAIM} was reprocessed. Paid in full: $88.20 + $14.70 interest = $102.90. Ref# 6620183. Allow 7-10 business days. - Provider Services (rep 4471)`],
  ['medicare-advantage', `CareFirst MedPlus (HMO)\nIntegrated denial notice\n\nName: {NAME}   Member ID: {MEMBER}\n\nWe denied payment for therapy assistant services billed with modifier CQ at the full rate. Under CMS rules the payment for services furnished in whole or in part by a physical therapist assistant is 85% of the fee schedule amount. 97110-CQ: fee schedule $30.26, 85% is $25.72, less the 20% coinsurance $5.14, paid $20.58 per unit; 6 units, $123.48. NCCI edit 97530/97140 applied to 1 unit (modifier 59 not billed). KX threshold $2,410 reached on 08/21/2026.\nYou may appeal within 60 days. Fax 1-855-555-0111.`],
  ['patient-letter', `Dear {GIVEN},\n\nYour health plan (BlueChoice PPO, group 0044781) has paid part of your therapy bill. Here is where it stands for your visits in September:\n\n  9/3   evaluation      billed $165.00, plan paid $98.40, you owe $25.00\n  9/10  treatment       billed $125.00, plan paid $71.15, you owe $25.00\n  9/17  treatment       billed $125.00, plan paid $0.00 (denied: needs a referral)\n\nWe have asked the plan to look again at the 9/17 visit. You do not need to do anything now. Your balance today is $50.00. Questions? Call the office at 757-555-0150 and ask for billing.\n\nThank you,\nTidewater Therapy Partners`],
