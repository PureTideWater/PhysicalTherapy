{
  "name": "@paidwhole/brand",
  "version": "1.0.0",
  "private": true,
  "description": "PaidWhole brand: design tokens, the mark as path data, fonts and logo assets. Framework-agnostic; used by apps/web and the report renderer in apps/worker.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mark": "./src/mark.ts",
    "./tokens": "./src/tokens.ts",
    "./name": "./src/name.ts",
    "./tokens.css": "./src/tokens.css",
    "./tailwind-theme.css": "./src/tailwind-theme.css",
    "./tailwind-preset": "./src/tailwind-preset.ts",
    "./assets/*": "./assets/*"
  },
  "files": [
    "src",
    "assets"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
