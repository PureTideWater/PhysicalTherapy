#!/usr/bin/env bash
# The repository's pre-push hook (docs/adr/0063, audit item #20 (e)). Before git sends a push, every commit it adds
# to the remote goes through the fixture check (the writer's guard over every file the commits write) and gitleaks
# (the repository's .gitleaks.toml and .gitleaksignore); a refusal stops the push. Turn it on once per clone, for
# the clone and every linked worktree of it:
#
#   git config core.hooksPath .githooks
#
# It needs the workspace installed (pnpm install) and gitleaks 8.19 or later on PATH, or GITLEAKS naming one; without
# either it refuses the push and says what to install. The checks are tools/pre-push/pre-push.ts.
set -euo pipefail

hook="$(readlink -f "${BASH_SOURCE[0]}")"
checkout="$(cd "$(dirname "$hook")/.." && pwd -P)"
tsx="$checkout/node_modules/.bin/tsx"
if [ ! -x "$tsx" ]; then
  echo "pre-push: $checkout has no node_modules/.bin/tsx, so this push is refused: run pnpm install there, and push again." >&2
  exit 1
fi
exec "$tsx" --tsconfig "$checkout/tools/tsconfig.json" "$checkout/tools/pre-push/index.ts" "$@"
